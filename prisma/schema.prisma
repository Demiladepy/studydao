// StudyDAO Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  name              String
  university        String
  learningStyle     String?
  goals             String?
  location          String?
  walletAddress     String?
  reputation        Int      @default(0)
  totalTokensEarned Int      @default(0)
  tokenBalance      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  courses       UserCourse[]
  availability  Availability[]
  groupMembers  GroupMember[]
  attendance    Attendance[]
  contributions Contribution[]
  transactions  Transaction[]
  studySessions  StudySession[]
  studyGoals    StudyGoal[]

  @@index([email])
  @@index([university])
}

model Course {
  id         String   @id @default(cuid())
  code       String
  name       String
  university String
  createdAt  DateTime @default(now())

  users         UserCourse[]
  groups        StudyGroup[]
  studySessions StudySession[]

  @@unique([code, university])
  @@index([university])
}

model UserCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Availability {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyGroup {
  id                 String   @id @default(cuid())
  courseId           String
  compatibilityScore Float    @default(0)
  status             String   @default("active")
  chatLink           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  sessions Session[]

  @@index([courseId])
  @@index([status])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Session {
  id                 String    @id @default(cuid())
  groupId            String
  scheduledTime      DateTime
  duration           Int
  location           String?
  status             String    @default("scheduled")
  tokensDistributed  Int       @default(0)
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  group         StudyGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendance    Attendance[]
  contributions Contribution[]

  @@index([groupId])
  @@index([scheduledTime])
  @@index([status])
}

model Attendance {
  id         String    @id @default(cuid())
  sessionId  String
  userId     String
  status     String
  arrivedAt  DateTime?
  createdAt  DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Contribution {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  points     Int      @default(0)
  activities String
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Int
  source      String
  sessionId   String?
  perkId      String?
  description String
  txHash      String?
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  perk Perk? @relation(fields: [perkId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Perk {
  id          String   @id @default(cuid())
  name        String
  description String
  cost        Int
  category    String
  tier        Int
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  @@index([category])
  @@index([tier])
}

model StudySession {
  id          String   @id @default(cuid())
  userId      String
  courseId    String?
  duration    Int       @default(0) // Duration in minutes
  startedAt   DateTime
  endedAt     DateTime?
  status      String   @default("active") // active, completed, paused
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([startedAt])
  @@index([status])
}

model StudyGoal {
  id          String   @id @default(cuid())
  userId      String
  type        String   // daily, weekly, monthly
  targetHours Int
  currentHours Float   @default(0)
  periodStart DateTime
  periodEnd   DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([type])
}